{
    // Cloudflare Workers Builds + assets-only Worker (no server code).
    // Git connect: connect this repo in the Cloudflare dashboard (Workers & Pages).
    // The build step runs `build.command` at `build.cwd`, then Cloudflare runs
    // `wrangler deploy` using this config.
    "$schema": "https://unpkg.com/wrangler/config-schema.json",
    "name": "com-sandlada-material-design-css",
    "compatibility_date": "2026-10-04",

    // Only the built Astro site is deployed, nothing else.
    "assets": {
        "directory": "./site/dist",
        // Serve ./404.html for unmatched routes (generated by site/src/pages/404.mdx).
        "not_found_handling": "404-page"
    },

    "build": {
        "cwd": ".",
        "command": "npm run site:build",
        "watch_dirs": [
            "site/src",
            "site/public",
            "site/package.json",
            "package.json",
            "preset.css",
            "color",
            "motion",
            "palette",
            "prebuilt-colors",
            "prebuilt-palettes",
            "shape",
            "space",
            "typography"
        ]
    },

    "observability": {
        "enabled": false
    }
}
